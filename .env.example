# ElevenLabs Agents. Sin esto la voz queda apagada y el botón se ve deshabilitado.
# La API key NUNCA va con prefijo NEXT_PUBLIC_: se queda en el servidor.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# El cliente solo necesita el id del agente (si es público) y el flag.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_VOICE_ENABLED=false
